{
  "name": "premiumhome-web",
  "version": "0.1.0",
  "private": true,
  "description": "Premium Home - prototype website (HTML, JS, Tailwind CSS)",
  "author": "PhuongVM",
  "scripts": {
    "build:css": "tailwindcss -i src/app.css -o site/assets/css/app.css --minify",
